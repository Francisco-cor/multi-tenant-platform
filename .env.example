NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
TENANT_BASE_DOMAIN=app.localhost
WEB_PUBLIC_URL=http://app.localhost:3000
WEB_PORT=3000
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
DATABASE_ROLE=platform_app
WORKER_DATABASE_ROLE=platform_worker
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4010
WORKER_READY_FILE=/tmp/platform-worker-ready
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
# Use fake only for tests/local without object storage; production requires s3.
S3_PROVIDER=fake
S3_REGION=us-east-1
S3_BUCKET=platform-local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
# Local-only demo key; generate a dedicated KMS/Vault-backed 32-byte base64url key in production.
WEBHOOK_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=platform-local
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://api.localhost:4000/v1/auth/callback
PAYMENT_WEBHOOK_SECRET=change-me-local-payment-secret
WEBHOOK_INBOUND_SECRET=change-me-local-inbound-secret
# The fake provider is local-only; production requires the real adapter and key.
PAYMENT_PROVIDER=fake
PAYMENT_PROVIDER_API_KEY=local-only-placeholder
PAYMENT_PROVIDER_BASE_URL=https://api.stripe.com
PAYMENT_PROVIDER_TIMEOUT_MS=5000
OTEL_SERVICE_NAME=platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
ALLOW_DEV_LOGIN=1
CSRF_STRICT=0
RATE_LIMIT_ENABLED=1
TRUST_PROXY=0
