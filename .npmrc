engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false
# Supply-chain hardening: refuse packages published less than 7 days ago.
# `min-release-age` is the npm spelling; `minimum-release-age` is the pnpm
# spelling (minutes). pnpm-workspace.yaml is the authoritative setting.
min-release-age=7
minimum-release-age=10080
