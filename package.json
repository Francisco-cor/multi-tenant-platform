{
  "name": "multi-tenant-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint --config eslint.config.mjs scripts --max-warnings=0",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:check": "node scripts/check-openapi.mjs",
    "migrate:check": "node scripts/analyze-migrations.mjs",
    "docker:tag": "node scripts/docker-tag.mjs",
    "docker:build": "node scripts/docker-tag.mjs && docker build -f apps/api/Dockerfile --build-arg COMMIT_SHA=$(git rev-parse HEAD) --build-arg BUILD_DATE=$(date +%Y%m%d) -t platform-api:$(git rev-parse --short HEAD) .",
    "smoke": "node scripts/smoke.mjs",
    "rolling:check": "node scripts/rolling-deploy-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "yaml": "^2.9.0"
  }
}
