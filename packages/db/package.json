{
  "name": "@platform/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx src/migrate.ts",
    "backup": "tsx src/backup.ts",
    "restore:drill": "tsx src/restore-drill.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.2.4"
  }
}
